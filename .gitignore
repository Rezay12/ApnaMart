# ==========================================
# ApnaMart Root .gitignore
# ==========================================

# Compiled & Build Artifacts
**/target/
**/dist/
**/build/
*.class
*.jar
*.war
*.ear

# Dependency Directories
**/node_modules/
.pnp
.pnp.js

# Environment & Secret Configurations
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.local

# IDE & Editor Settings
.idea/
*.iml
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# Logs & Temporary Files
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.tmp
*.bak
*.zip

# Test & Coverage Outputs
coverage/
*.lcov
.nyc_output

# Project Temporary Screenshots & Data Exports
screenshots_and_diagrams/
Database_Screenshots/
*.png
!docs/assets/*.png
